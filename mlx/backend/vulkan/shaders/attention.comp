#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// Scaled Dot-Product Attention shader
// Computes: softmax(Q * K^T / sqrt(d_k)) * V

#define BLOCK_SIZE 64

layout(local_size_x = BLOCK_SIZE) in;

layout(set = 0, binding = 0) readonly buffer Query { float Q[]; };
layout(set = 0, binding = 1) readonly buffer Key { float K[]; };
layout(set = 0, binding = 2) readonly buffer Value { float V[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float O[]; };
layout(set = 0, binding = 4) readonly buffer Mask { float mask[]; };  // Optional attention mask

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint num_heads;
    uint seq_len;
    uint head_dim;
    float scale;
    uint use_mask;
} params;

shared float shared_scores[BLOCK_SIZE];
shared float shared_max[BLOCK_SIZE];
shared float shared_sum[BLOCK_SIZE];

void main() {
    uint batch = gl_WorkGroupID.z;
    uint head = gl_WorkGroupID.y;
    uint query_pos = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    
    uint head_stride = params.seq_len * params.head_dim;
    uint batch_stride = params.num_heads * head_stride;
    
    uint q_base = batch * batch_stride + head * head_stride + query_pos * params.head_dim;
    uint o_base = q_base;
    
    // Initialize output accumulator to zero
    float output_acc[4];  // Assuming head_dim <= 256 and we process 4 elements per thread
    for (int d = 0; d < 4; d++) {
        output_acc[d] = 0.0;
    }
    
    float max_score = -1e38;
    float sum_exp = 0.0;
    
    // Process all key positions
    for (uint key_pos = 0; key_pos < params.seq_len; key_pos++) {
        uint k_base = batch * batch_stride + head * head_stride + key_pos * params.head_dim;
        uint v_base = k_base;
        
        // Compute Q * K^T for this position
        float score = 0.0;
        for (uint d = tid; d < params.head_dim; d += BLOCK_SIZE) {
            score += Q[q_base + d] * K[k_base + d];
        }
        
        // Reduce within workgroup to get full dot product
        shared_scores[tid] = score;
        barrier();
        
        for (uint s = BLOCK_SIZE / 2; s > 0; s >>= 1) {
            if (tid < s) {
                shared_scores[tid] += shared_scores[tid + s];
            }
            barrier();
        }
        
        score = shared_scores[0] * params.scale;
        
        // Apply mask if needed
        if (params.use_mask != 0) {
            uint mask_idx = batch * params.seq_len * params.seq_len + 
                           query_pos * params.seq_len + key_pos;
            score += mask[mask_idx];
        }
        
        // Online softmax: update max and rescale
        float old_max = max_score;
        max_score = max(max_score, score);
        float exp_diff = exp(old_max - max_score);
        
        // Rescale previous accumulations
        sum_exp *= exp_diff;
        for (int d = 0; d < 4; d++) {
            output_acc[d] *= exp_diff;
        }
        
        // Add current contribution
        float exp_score = exp(score - max_score);
        sum_exp += exp_score;
        
        // Accumulate weighted values
        for (uint d = tid; d < params.head_dim && d < tid + 4 * BLOCK_SIZE; d += BLOCK_SIZE) {
            uint local_d = (d - tid) / BLOCK_SIZE;
            if (local_d < 4) {
                output_acc[local_d] += exp_score * V[v_base + d];
            }
        }
        
        barrier();
    }
    
    // Normalize by sum and write output
    float inv_sum = 1.0 / sum_exp;
    for (uint d = tid; d < params.head_dim && d < tid + 4 * BLOCK_SIZE; d += BLOCK_SIZE) {
        uint local_d = (d - tid) / BLOCK_SIZE;
        if (local_d < 4) {
            O[o_base + d] = output_acc[local_d] * inv_sum;
        }
    }
}
