#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// Layer normalization shader
// output = (x - mean) / sqrt(var + eps) * weight + bias

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Input { float in_data[]; };
layout(set = 0, binding = 1) readonly buffer Weight { float weight[]; };
layout(set = 0, binding = 2) readonly buffer Bias { float bias[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint hidden_size;
    float eps;
} params;

shared float shared_sum[256];
shared float shared_sq_sum[256];

void main() {
    uint batch = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint offset = batch * params.hidden_size;
    
    // Initialize shared memory
    shared_sum[tid] = 0.0;
    shared_sq_sum[tid] = 0.0;
    barrier();
    
    // Step 1: Compute sum for mean
    float local_sum = 0.0;
    for (uint i = tid; i < params.hidden_size; i += gl_WorkGroupSize.x) {
        local_sum += in_data[offset + i];
    }
    shared_sum[tid] = local_sum;
    barrier();
    
    // Reduce sum
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }
    
    float mean = shared_sum[0] / float(params.hidden_size);
    barrier();
    
    // Step 2: Compute variance
    float local_sq_sum = 0.0;
    for (uint i = tid; i < params.hidden_size; i += gl_WorkGroupSize.x) {
        float diff = in_data[offset + i] - mean;
        local_sq_sum += diff * diff;
    }
    shared_sq_sum[tid] = local_sq_sum;
    barrier();
    
    // Reduce variance
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sq_sum[tid] += shared_sq_sum[tid + s];
        }
        barrier();
    }
    
    float variance = shared_sq_sum[0] / float(params.hidden_size);
    float inv_std = 1.0 / sqrt(variance + params.eps);
    barrier();
    
    // Step 3: Normalize
    for (uint i = tid; i < params.hidden_size; i += gl_WorkGroupSize.x) {
        float normalized = (in_data[offset + i] - mean) * inv_std;
        out_data[offset + i] = normalized * weight[i] + bias[i];
    }
}
