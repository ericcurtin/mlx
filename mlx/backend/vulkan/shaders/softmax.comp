#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer Input { float in_data[]; };
layout(set = 0, binding = 1) writeonly buffer Output { float out_data[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint seq_len;
} params;

shared float shared_max[256];
shared float shared_sum[256];

void main() {
    uint batch = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    uint offset = batch * params.seq_len;
    
    // Initialize shared memory
    shared_max[tid] = -1e38;
    shared_sum[tid] = 0.0;
    barrier();
    
    // Step 1: Find max value - each thread processes multiple elements
    float local_max = -1e38;
    for (uint i = tid; i < params.seq_len; i += gl_WorkGroupSize.x) {
        local_max = max(local_max, in_data[offset + i]);
    }
    shared_max[tid] = local_max;
    barrier();
    
    // Reduce max within workgroup
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_max[tid] = max(shared_max[tid], shared_max[tid + s]);
        }
        barrier();
    }
    
    float max_val = shared_max[0];
    barrier();
    
    // Step 2: Compute exp and sum
    float local_sum = 0.0;
    for (uint i = tid; i < params.seq_len; i += gl_WorkGroupSize.x) {
        float exp_val = exp(in_data[offset + i] - max_val);
        out_data[offset + i] = exp_val;
        local_sum += exp_val;
    }
    shared_sum[tid] = local_sum;
    barrier();
    
    // Reduce sum within workgroup
    for (uint s = gl_WorkGroupSize.x / 2; s > 0; s >>= 1) {
        if (tid < s) {
            shared_sum[tid] += shared_sum[tid + s];
        }
        barrier();
    }
    
    float sum_val = shared_sum[0];
    barrier();
    
    // Step 3: Normalize
    for (uint i = tid; i < params.seq_len; i += gl_WorkGroupSize.x) {
        out_data[offset + i] /= sum_val;
    }
}
