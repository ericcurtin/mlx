#version 450
#extension GL_EXT_shader_explicit_arithmetic_types : enable

// Rotary Position Embedding (RoPE) shader
// Applies rotary position embeddings to queries and keys

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer InOut { float data[]; };
layout(set = 0, binding = 1) readonly buffer FreqsCos { float freqs_cos[]; };
layout(set = 0, binding = 2) readonly buffer FreqsSin { float freqs_sin[]; };

layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint seq_len;
    uint num_heads;
    uint head_dim;
    uint offset;  // Position offset for incremental decoding
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    uint total_size = params.batch_size * params.seq_len * params.num_heads * params.head_dim;
    
    if (idx >= total_size / 2) return;
    
    // Compute indices
    uint pair_idx = idx;
    uint dim_idx = (pair_idx * 2) % params.head_dim;
    uint head_idx = (pair_idx / (params.head_dim / 2)) % params.num_heads;
    uint seq_idx = (pair_idx / (params.num_heads * params.head_dim / 2)) % params.seq_len;
    uint batch_idx = pair_idx / (params.seq_len * params.num_heads * params.head_dim / 2);
    
    uint pos = seq_idx + params.offset;
    uint freq_idx = pos * (params.head_dim / 2) + dim_idx / 2;
    
    float cos_val = freqs_cos[freq_idx];
    float sin_val = freqs_sin[freq_idx];
    
    uint base_idx = batch_idx * params.seq_len * params.num_heads * params.head_dim +
                    seq_idx * params.num_heads * params.head_dim +
                    head_idx * params.head_dim +
                    dim_idx;
    
    float x0 = data[base_idx];
    float x1 = data[base_idx + 1];
    
    // Apply rotation
    data[base_idx] = x0 * cos_val - x1 * sin_val;
    data[base_idx + 1] = x0 * sin_val + x1 * cos_val;
}
